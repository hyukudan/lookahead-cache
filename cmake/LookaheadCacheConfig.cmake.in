@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@SL_ENABLE_HIP@)
    find_dependency(hip CONFIG)
endif()
if(@SL_ENABLE_CUDA@)
    find_dependency(CUDAToolkit 12.8)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LookaheadCacheTargets.cmake")
foreach(_sl_component IN ITEMS cache hip cuda)
    set(LookaheadCache_${_sl_component}_FOUND FALSE)
    if(TARGET LookaheadCache::${_sl_component})
        set(LookaheadCache_${_sl_component}_FOUND TRUE)
    endif()
endforeach()
unset(_sl_component)
check_required_components(LookaheadCache)
