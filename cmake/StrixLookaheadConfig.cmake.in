@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@SL_ENABLE_HIP@)
    find_dependency(hip CONFIG)
endif()
if(@SL_ENABLE_CUDA@)
    find_dependency(CUDAToolkit 12.8)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/StrixLookaheadTargets.cmake")
foreach(_sl_component IN ITEMS cache hip cuda)
    set(StrixLookahead_${_sl_component}_FOUND FALSE)
    if(TARGET StrixLookahead::${_sl_component})
        set(StrixLookahead_${_sl_component}_FOUND TRUE)
    endif()
endforeach()
unset(_sl_component)
check_required_components(StrixLookahead)
