@PACKAGE_INIT@
# Deprecated pre-0.4.2 package name.
include(CMakeFindDependencyMacro)
find_dependency(LookaheadCache @PROJECT_VERSION@ EXACT CONFIG
    PATHS "${CMAKE_CURRENT_LIST_DIR}/../LookaheadCache")
foreach(_sl_component IN ITEMS cache hip cuda)
    set(StrixLookahead_${_sl_component}_FOUND FALSE)
    if(TARGET LookaheadCache::${_sl_component})
        if(NOT TARGET StrixLookahead::${_sl_component})
            add_library(StrixLookahead::${_sl_component} INTERFACE IMPORTED)
            target_link_libraries(StrixLookahead::${_sl_component} INTERFACE LookaheadCache::${_sl_component})
        endif()
        set(StrixLookahead_${_sl_component}_FOUND TRUE)
    endif()
endforeach()
unset(_sl_component)
check_required_components(StrixLookahead)
